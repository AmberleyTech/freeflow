<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.freeflowstats.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BINARY__</string>
	</array>
	<key>WatchPaths</key>
	<array>
		<string>__HOME__/Library/Application Support/FreeFlow/PipelineHistory.sqlite</string>
		<string>__HOME__/Library/Application Support/FreeFlow/PipelineHistory.sqlite-wal</string>
		<string>__HOME__/Library/Application Support/FreeFlow/PipelineHistory.sqlite-shm</string>
		<string>__HOME__/Library/Application Support/FreeFlow Dev/PipelineHistory.sqlite</string>
		<string>__HOME__/Library/Application Support/FreeFlow Dev/PipelineHistory.sqlite-wal</string>
		<string>__HOME__/Library/Application Support/FreeFlow Dev/PipelineHistory.sqlite-shm</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
